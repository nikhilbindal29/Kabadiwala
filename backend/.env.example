# ============================================================
# ScrapSetu Backend - Environment Variables
# Copy this file to .env and fill in real values
# ============================================================

# ---- Application ----
APP_ENV=development
APP_NAME=ScrapSetu
APP_VERSION=1.0.0

# ---- Security (REQUIRED) ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_use_a_long_random_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Admin Provisioning ----
# Used only for the first admin account creation endpoint
ADMIN_SETUP_TOKEN=CHANGE_ME_admin_setup_token

# ---- Storage ----
STORAGE_BACKEND=csv
DATA_DIR=data
CSV_DIR=data/csv
UPLOADS_DIR=data/uploads
EXPORTS_DIR=data/exports
BACKUPS_DIR=data/backups
MAX_UPLOAD_SIZE_MB=10

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ---- Rate Limiting ----
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ---- OTP (development only) ----
# In production, integrate with SMS/email provider
OTP_EXPIRE_MINUTES=10
